{
  "name": "@cr-ia/api",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*"
  },
  "scripts": {
    "dev": "tsx watch src/server-node.ts",
    "build": "tsc -p tsconfig.json && rm -rf dist/workflows && cp -r workflows dist/workflows",
    "start": "node dist/server-node.js",
    "seed": "tsx src/seed.ts",
    "migrate": "tsx src/migrate.ts",
    "test": "vitest run --reporter=verbose"
  },
  "dependencies": {
    "@cr-ia/shared": "*",
    "@hono/node-server": "^1.13.0",
    "bcryptjs": "^2.4.3",
    "hono": "^4.6.0",
    "jose": "^5.9.0",
    "mammoth": "^1.13.0",
    "nodemailer": "^10.2.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.13.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.16.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
