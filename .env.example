# =====================================================================
# CR IA v0.2.0 — variáveis de ambiente (EXEMPLO SEGURO — sem segredos reais)
# Copie para .env e preencha. O instalador deploy-vps-pronta.sh gera
# JWT_SECRET e POSTGRES_PASSWORD sozinho se estiverem vazios.
# =====================================================================

# ---- Núcleo -----------------------------------------------------------
NODE_ENV=production
# PUBLIC_API_URL: URL pública da API (atrás do Cloudflare Tunnel).
PUBLIC_API_URL=https://ia.crjornada.com/api
# CORS: origens permitidas (separadas por vírgula).
CORS_ORIGINS=https://ia.crjornada.com
# Segredo do JWT (gerado automaticamente pelo instalador):
JWT_SECRET=
# Senhas iniciais (seed) — TROQUE ANTES DO PRIMEIRO DEPLOY:
ADMIN_PASSWORD=Trocar123!
GUEST_PASSWORD=Trocar123!

# ---- Banco de dados ----------------------------------------------------
POSTGRES_DB=cria
POSTGRES_USER=cria
# Gerada automaticamente pelo instalador se vazia:
POSTGRES_PASSWORD=

# ---- Rede local (VPS atrás do Cloudflare Tunnel — só loopback) ---------
WEB_PORT=3000
API_PORT=8787
OLLAMA_PORT=11434
AI_LOCAL_PORT=8001

# ---- IA local (Ollama + perfis opcionais) -------------------------------
# OLLAMA_URL: dentro do compose use http://ollama:11434; fora dele,
# http://127.0.0.1:11434. Vazios = perfis desligados.
OLLAMA_URL=http://ollama:11434
OLLAMA_TEXT_MODELS=qwen3:4b
CHAT_PROVIDER=ollama
AUTO_MODEL_SELECT=true
# openrouter (recomendado, exige chave+créditos) | pollinations (grátis, fallback)
# | workers-ai | external-gpu | mock-svg (demo). Padrão do painel prevalece.
IMAGE_PROVIDER=openrouter
ENABLE_POLLINATIONS=true

# ---- Provedores de IA por API (TODOS PAGOS — vazios = "Configurar API") ---
# Chaves criadas nos consoles oficiais. Sem chave, o modelo aparece como
# "Indisponível — Configurar API" e NUNCA é chamado. Alternativa sem .env:
# Administração → Credenciais (cofre cifrado; exige CREDENTIALS_SECRET).
CREDENTIALS_SECRET=
OPENAI_API_KEY=
#OPENAI_MODELS=gpt-5-mini,gpt-5
#OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
#ANTHROPIC_MODELS=claude-opus-4-6,claude-sonnet-4-6
GOOGLE_AI_KEY=
#GEMINI_API_KEY=
#GOOGLE_MODELS=gemini-3.8-flash,gemini-4-argon
XAI_API_KEY=
#XAI_MODELS=grok-4.7,grok-4.3
DEEPSEEK_API_KEY=
#DEEPSEEK_MODELS=deepseek-chat,deepseek-reasoner
MISTRAL_API_KEY=
#MISTRAL_MODELS=mistral-large-latest,mistral-medium-latest

# ---- IAs GRATUITAS com chave (free-tier: $0, cotas rígidas, sem cartão) --
# Groq: console.groq.com → API Keys (gsk-...). Grátis: 30 req/min,
# 1.000 req/dia, 200K tok/dia (out/2026). Não é ilimitado.
GROQ_API_KEY=
#GROQ_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b
# OpenRouter (PROVEDOR PRIMÁRIO, v0.3.0): openrouter.ai/keys (sk-or-v1-...).
# Catálogo DINÂMICO: o sistema sincroniza os modelos da API oficial
# (texto + imagem + preços), sem lista fixa. Grátis têm cotas rígidas
# (20 req/min, 50 req/dia); pagos exigem créditos E ativação por modelo
# no painel (Administração → Provedores de IA). Alguns hosts de modelos
# grátis podem treinar com prompts — NUNCA envie dados sensíveis.
# A chave aqui tem prioridade e é preservada; alternativa: cofre do painel.
OPENROUTER_API_KEY=
#OPENROUTER_MODELS=
#OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_REFERER=https://ia.crjornada.com
# NVIDIA NIM: Developer Free Endpoints exclusivamente para testes/prototipagem.
# Configure a chave na área de Credenciais do Admin ou via .env (tem prioridade).
# Conferir Free Endpoint manualmente em https://build.nvidia.com/models.
# A lista /v1/models pode conter modelos não gratuitos ou incompatíveis.
NVIDIA_API_KEY=
NVIDIA_MODELS=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ---- Busca web (Fase 3) ------------------------------------------------
# Padrão: SearXNG próprio (perfil "search" do compose; grátis, sem conta).
# Provedores por chave (pagos/planos): Brave, Tavily, Google Programmable
# Search. Vazios = desligados. Alternativa sem .env: Administração →
# Credenciais (cofre cifrado). WEB_SEARCH_PROVIDER força um deles.
SEARXNG_URL=http://searxng:8080
WEB_SEARCH_PROVIDER=
BRAVE_API_KEY=
#BRAVE_BASE_URL=https://api.search.brave.com
TAVILY_API_KEY=
#TAVILY_BASE_URL=https://api.tavily.com
GOOGLE_PSE_KEY=
GOOGLE_PSE_CX=
#GOOGLE_PSE_BASE_URL=https://www.googleapis.com

# ---- Voz + busca em documentos (serviço ai-local, perfil "ai") ----------
# URL interna que a API usa para falar com o ai-local (Docker network):
AI_LOCAL_URL=http://ai-local:8001
# Modelo Whisper (tiny/base/small/medium/large-v3) e diretório dos pesos:
WHISPER_MODEL=small
WHISPER_MODEL_DIR=/models/whisper
# Embedding local multilíngue (BAAI/bge-m3, licença MIT):
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_MODEL_DIR=/models/embeddings
# Provedor externo de transcrição (opcional, pago — precisa de autorização):
EXTERNAL_TRANSCRIBE_URL=
EXTERNAL_TRANSCRIBE_API_KEY=

# ---- Agente desenvolvedor (isolado, só age com autorização) --------------
# Token GitHub de escopo mínimo (repo) — usado apenas nos 4 repos permitidos:
GITHUB_TOKEN=
# Diretório dos clones isolados (volume agentwork — NUNCA /opt/cr-ia/app):
AGENT_WORK_DIR=/agentwork
# Aprovações: merge em main, deploy em produção, comandos destrutivos e
# operações em banco de produção exigem aprovação humana explícita (sempre ON):
AGENT_REQUIRE_APPROVAL=true
# Testes do agente: docker (contêineres descartáveis, exige socket montado
# no worker) | host (SÓ com AGENT_ALLOW_HOST_EXEC=true, não recomendado) |
# auto (docker se houver, senão registra e pula — padrão seguro).
AGENT_RUNNER=auto
AGENT_ALLOW_HOST_EXEC=false
# Correções automáticas após teste falhar (0 desliga; máx 5). Push/PR/merge sempre exigem aprovação.
AGENT_FIX_ATTEMPTS=2
AGENT_SANDBOX_NETWORK=bridge
# Central de Atualizações: segredo HMAC p/ assinar ZIPs (gerado pelo dono;
# sem ele, ZIPs entram como "não assinados" e exigem aceite explícito).
# URL do manifesto JSON da Central de Atualizações (ver docs/UPDATES.md).
# Sem ela, a Central mostra "não configurado" (nada é baixado/aplicado).
UPDATES_MANIFEST_URL=
# HMAC que autentica aprovações/rollbacks para o serviço updater (obrigatório;
# gerado pelo instalador; sem ele, aprovar retorna erro e nada é enfileirado):
UPDATER_QUEUE_SECRET=
# Chave pública minisign (SÓ a 2ª linha do .pub, base64 em linha única).
# Sem ela, todo upload de ZIP é RECUSADO. Gere/assine com:
# node scripts/sign-release.mjs genkey --name cr-ia-release --out /seguro/offline
# (o .key fica OFFLINE — nunca no servidor; roteiro em docs/UPDATES.md)
UPDATE_SIGNING_PUBLIC_KEY=
# Teto do ZIP no upload da Central (MB) + testes completos no staging (opt-in, lento).
UPDATE_MAX_ZIP_MB=256
UPDATE_RUN_TESTS=false
# Limites de recursos do worker (agente roda dentro do worker):
AGENT_MAX_PARALLEL_RUNS=1
AGENT_RUN_TIMEOUT_MIN=20

# ---- E-mail de recuperação de senha (SMTP do cliente) --------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CR IA <nao-responda@crjornada.com>"
# Em desenvolvimento, sem SMTP, o link aparece no log da API (dev-only).

# ---- Geração de imagem externa (Pollinations — camada gratuita) ----------
# Limites reais da camada gratuita clássica:
#   imagens 1 por vez (mín. ~45s entre pedidos por IP), 402 + Retry-After
#   quando exceder, sem SLA, JPEG com logo. Opcional: chave enter.pollinations.ai
#   remove limite por IP e o logo.
POLLINATIONS_TEXT_MODEL=openai
POLLINATIONS_IMAGE_MODEL=flux
POLLINATIONS_API_KEY=
# GPU externa futura (ComfyUI sob seu controle; vazio = desligado):
EXTERNAL_GPU_URL=
EXTERNAL_GPU_API_KEY=

# ---- Backup externo criptografado (Cloudflare R2) ------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=cr-ia-backups
R2_ENDPOINT=
# Backup local v0.2.0 (scripts/backup.sh): subdir novo dentro da árvore do Restic.
BACKUP_DIR=/opt/cr-ia/data/cr-ia-dumps
# Conjuntos completos guardados (piso de segurança: 2). Ver docs/INSTALACAO.md §2.4.
RETENTION_SETS=14

# ---- Opcionais herdados (têm padrão seguro no compose) -------------------
ADMIN_EMAIL=admin@cr-ia.local
ADMIN_NAME=Administrador
GUEST_EMAIL=convidada@cr-ia.local
GUEST_NAME=Usuária Convidada
JWT_EXPIRES_IN=12h
BCRYPT_COST=10
MAX_UPLOAD_MB=25
TZ=America/Sao_Paulo
GITHUB_ALLOWED_REPOS=rykellmy31-star/gestor-ponto-multiempresa,rykellmy31-star/GESTOR-BARBEARIA,rykellmy31-star/Site-farmacia_paguePouco,rykellmy31-star/CATALOGO-Multilojas
DAILY_LIMIT_CHAT=200
DAILY_LIMIT_IMAGES=50
WORKER_POLL_MS=5000
SEARXNG_PORT=8888
# Provedores pagos sempre bloqueados sem autorização explícita (não altere):
BLOCK_PAID_PROVIDERS=true
